# MongoDB connection string (e.g. MongoDB Atlas SRV URI).
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# Database name used by the app.
MONGODB_DB=todo

# --- GitHub OAuth ---
# Create an OAuth App at https://github.com/settings/developers and register
# a callback URL per origin you use (the app allows several):
#   http://localhost:3000/auth/github/callback
#   https://<your-domain>/auth/github/callback
# See docs/GITHUB_OAUTH_SETUP.md for the full walkthrough.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional: the callback URL is derived from the request by default. Set this
# only to force one fixed callback (e.g. behind an origin-obscuring proxy).
# GITHUB_OAUTH_REDIRECT_URI=

# Used only by the one-time `npm run migrate-user-id` script: the GitHub
# login that all pre-auth data should be assigned to (that account must have
# logged in once first). Leave blank if starting with an empty database.
SEED_OWNER_GITHUB_LOGIN=
